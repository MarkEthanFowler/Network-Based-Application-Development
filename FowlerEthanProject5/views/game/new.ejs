<%- include('../partials/header.ejs')%>

    <main class="newStyle">
        <h1>Want to Sell At Exemplary Games</h1>
        <p>It's easy fill out the information for your item or snap a picture with your phone</p>
        <form action="/games" method="POST" class="new-form" enctype="multipart/form-data">
            <div class="condition">
                <label for="condition">Condition:</label>
                <select id="condition" name="condition" required>
                    <option value="">Select an Option</option>
                    <option value="Near Mint">Near Mint</option>
                    <option value="Lightly Used">Lightly Used</option>
                    <option value="Moderately Used">Moderately Used</option>
                    <option value="Heavily Used">Heavily Used</option>
                    <option value="Damaged">Damaged</option>
                </select>
            </div>
            <div class="title">
                <label for="title">Title:</label>
                <input type="text" id="title" name="title" required>
            </div>
            <div class="price">
                <label for="price">Price:</label>
                <input type="number" id="price" name="price" required step="0.01">
            </div>
            <div class="details">
                <label for="details">Details:</label>
                <textarea id="details" name="details" rows="10" cols="50" required></textarea>
            </div>

            <div class="imageFile">
                <label for="imageFile">Image:</label>
                <input type="file" id="imageFile" name="image" accept="image/png, image/jpeg" required>
            </div>

            <div class="submit">
                <input type="submit">
            </div>
   
        </form>
    </main>
    <%- include('../partials/footer.ejs')%>
